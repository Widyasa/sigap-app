# Copy this file to supabase/functions/.env (local dev) or set as Supabase secrets (cloud).
# DO NOT commit the real values.

# Required for OTP hashing and refresh-token hashing.
OTP_PEPPER=change-me-to-a-random-32-byte-hex-string

# Resend API key for sending OTP emails.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address used by Resend. Must be from a verified domain in production.
EMAIL_FROM=SIGAP <otp@sigap.id>

# Set to true only in local development to return the OTP code in the response.
# In production this must be unset/false so the code is only sent via email.
OTP_DEV_MODE=false

# Supabase project JWT secret. Used to sign access/refresh tokens so PostgREST can verify them.
# In production, use your project's JWT secret from the Supabase dashboard.
SIGAP_JWT_SECRET=your-project-jwt-secret

# Service role key. The built-in SUPABASE_SERVICE_ROLE_KEY works in production.
# In local development, the CLI's built-in key may be signed with a different secret,
# so generate a service_role JWT signed with SIGAP_JWT_SECRET and set it here.
SIGAP_SERVICE_ROLE_KEY=your-service-role-jwt-signed-with-sigap-jwt-secret
