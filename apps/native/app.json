{
  "expo": {
    "name": "SIGAP",
    "slug": "sigap",
    "version": "1.0.0",
    "scheme": "sigap",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "extra": {
      "supabaseUrl": "https://kfbbaeuzvfzcbwjlopne.supabase.co",
      "supabasePublishableKey": "sb_publishable_scwzXInxD6edkia43QDjjA_WB5z_b9k",
      "router": {},
      "eas": {
        "projectId": "ca351132-e165-42a1-b30c-7e92198d2e92"
      }
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "white"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "white"
      },
      "package": "id.sigap.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "SIGAP butuh akses kamera untuk memotret aduan.",
          "photosPermission": "SIGAP butuh akses galeri untuk melampirkan foto aduan.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SIGAP butuh lokasi untuk menandai posisi aduan."
        }
      ],
      "expo-secure-store"
    ],
    "owner": "widyasa"
  }
}
