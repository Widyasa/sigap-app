{
  "expo": {
    "name": "native",
    "slug": "native",
    "version": "1.0.0",
    "scheme": "sigap",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "extra": {
      "supabaseUrl": "https://kfbbaeuzvfzcbwjlopne.supabase.co",
      "supabasePublishableKey": "sb_publishable_scwzXInxD6edkia43QDjjA_WB5z_b9k"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "white"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "white"
      },
      "package": "com.turbo.example"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "SIGAP butuh akses kamera untuk memotret aduan.",
          "photosPermission": "SIGAP butuh akses galeri untuk melampirkan foto aduan.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SIGAP butuh lokasi untuk menandai posisi aduan."
        }
      ]
    ]
  }
}
